# Generated files that stay tracked. linguist-generated collapses them in PR diffs.
# Everything else a generator writes is gitignored (scripts/generated.ts); `just generated-check` enforces this.

# Rendered by plugin/tools/plg.ts at release; installed systems read it from main (pluginURL).
plugin/ugreen-nas-control.plg linguist-generated=true
# Model tables rendered from web/models/ by docs/tools/gen-docs.ts; GitHub shows the README, `just docs-check` keeps it current.
README.md linguist-generated=true
docs/hardware.md linguist-generated=true
# Its <Overview> is rendered from docs/site/facts.ts by gen-docs.ts; Community Applications reads the file from main, `just docs-check` keeps it current.
plugins/ugreen-nas-control.xml linguist-generated=true
# Release history, written by plugin/tools/changes.ts at release.
CHANGELOG.md linguist-generated=true
# Recorded UI test snapshot, rewritten by `just e2e --update`.
web/tools/e2e/golden.json linguist-generated=true
# Replies of the real api.php / led/api.php to the case table, re-recorded by `bun web/tools/api-oracle/oracle.ts --update`.
web/tools/api-oracle/golden.json linguist-generated=true
# Model registry as JSON for `ugreen-nas-ctl diag` (go:embed), rendered from web/models/ by docs/tools/gen-docs.ts; tracked so a Go build works in a clean checkout, `just docs-check` keeps it current.
backend/internal/nasctl/models.json linguist-generated=true
# Issue forms of the Feedback page, rendered from the model registry by docs/tools/gen-templates.ts; `just docs-check` keeps them current.
.github/ISSUE_TEMPLATE/model-report.yml linguist-generated=true
.github/ISSUE_TEMPLATE/bug.yml linguist-generated=true
